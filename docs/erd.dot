digraph ERD {
rankdir=LR; nodesep=0.35; ranksep=1.1; splines=true; bgcolor="white"; pad=0.4;
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [color="#374151", arrowtail=tee, arrowhead=crow, dir=both, penwidth=1.2];
labelloc=t; fontname="Helvetica-Bold"; fontsize=18; label="Agriculture Information System - Entity-Relationship Diagram (PK = primary key, FK = foreign key; 1 ──< many)";
"farmer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#15803d"><FONT COLOR="white"><B>FARMER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">farmer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">first_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">last_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="contact_number">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">contact_number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">address</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_registered">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">date_registered</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">created_at / updated_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">created_by / updated_by</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR></TABLE>>];
"farm" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#15803d"><FONT COLOR="white"><B>FARM</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">farm_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">farmer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="farm_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">farm_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="location">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">location</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="area_hectares">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">area_hectares</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">soil_type_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">irrigation_type_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">created_at / updated_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">created_by / updated_by</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR></TABLE>>];
"crop" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#15803d"><FONT COLOR="white"><B>CROP</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">crop_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="crop_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">crop_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="variety">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">variety</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">crop_category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="growing_period_days">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">growing_period_days</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">season_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">created_at / updated_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">created_by / updated_by</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR></TABLE>>];
"planting" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#15803d"><FONT COLOR="white"><B>PLANTING</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">planting_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">farm_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">crop_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="planting_date">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">planting_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="area_planted">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">area_planted</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seed_quantity">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">seed_quantity</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expected_harvest_date">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">expected_harvest_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">status_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">created_at / updated_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">created_by / updated_by</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR></TABLE>>];
"harvest" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#15803d"><FONT COLOR="white"><B>HARVEST</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">harvest_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">planting_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="harvest_date">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">harvest_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_kg">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">quantity_kg</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="selling_price_per_kg">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">selling_price_per_kg</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">grade_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">remark_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">created_at / updated_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">created_by / updated_by</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR></TABLE>>];
"soil_types" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>SOIL_TYPES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">soil_type_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="soil_type_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">soil_type_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(50)</FONT></TD></TR></TABLE>>];
"irrigation_types" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>IRRIGATION_TYPES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">irrigation_type_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="irrigation_type_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">irrigation_type_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(50)</FONT></TD></TR></TABLE>>];
"crop_categories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>CROP_CATEGORIES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">crop_category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">category_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(50)</FONT></TD></TR></TABLE>>];
"seasons" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>SEASONS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">season_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">season_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(30)</FONT></TD></TR></TABLE>>];
"planting_statuses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>PLANTING_STATUSES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">status_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">status_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(30)</FONT></TD></TR></TABLE>>];
"quality_grades" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>QUALITY_GRADES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">grade_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grade_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">grade_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(30)</FONT></TD></TR></TABLE>>];
"harvest_remarks" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>HARVEST_REMARKS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">remark_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="remark_description">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">remark_description</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(200)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6b7280"><FONT COLOR="white"><B>USERS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">username</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">full_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">password_hash</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">is_active</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">created_at / updated_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"roles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9ca3af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6b7280"><FONT COLOR="white"><B>ROLES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_name">&nbsp;&nbsp;</TD><TD ALIGN="LEFT"><FONT COLOR="#374151">role_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">VARCHAR(30)</FONT></TD></TR></TABLE>>];
"farmer" -> "farm";
"farm" -> "planting";
"crop" -> "planting";
"planting" -> "harvest";
"soil_types" -> "farm";
"irrigation_types" -> "farm";
"crop_categories" -> "crop";
"seasons" -> "crop";
"planting_statuses" -> "planting";
"quality_grades" -> "harvest";
"harvest_remarks" -> "harvest";
"roles" -> "users";
}